// =====================================================
// MARK: - 6. THE REIFIED KERNEL
// =====================================================

public final class DVSMKernel: Sendable {

    // =================================================
    // MARK: INTERNAL STATE
    // =================================================

    struct KernelState {

        var manifoldPhase: FixedPoint
        var calibration: DVSMCalibrationFrame
        var accumulatedAction: Double
        var trajectory: [DVSMTrajectorySample]
        var lifecycle: DVSMLifecycle
    }

    private let state: OSAllocatedUnfairLock<KernelState>
    private let settings: DVSMKineticSettings

    // =================================================
    // MARK: INITIALIZATION
    // =================================================

    public init(
        bootstrap: FixedPoint,
        settings: DVSMKineticSettings = .default
    ) {

        self.settings = settings

        self.state = OSAllocatedUnfairLock(
            initialState: KernelState(
                manifoldPhase: bootstrap,
                calibration: .identity,
                accumulatedAction: 0.0,
                trajectory: [],
                lifecycle: .initializing
            )
        )
    }

    // =================================================
    // MARK: PRIMARY REIFIED PULSE
    // =================================================

    /// Primary SDK entry point.
    ///
    /// Implements recursive semantic filtering through
    /// manifold persistence dynamics.
    ///
    /// - Parameters:
    ///   - input: Arbitrary payload.
    ///   - telemetry: External manifold observation.
    ///
    /// - Returns:
    ///   A tuple containing:
    ///   1. Domain-separated truth digest.
    ///   2. Persistence scalar.
    public func pulse(
        input: Data,
        telemetry: FixedPoint
    ) throws -> (truth: Data, persistence: Double) {

        return try state.withLock { state in

            guard state.lifecycle != .terminal else {
                throw DVSMError.terminalStateViolation
            }

            // -------------------------------------------------
            // 1. FIELD PRESSURE COMPUTATION
            // -------------------------------------------------

            let delta = abs(
                telemetry.doubleValue -
                state.manifoldPhase.doubleValue
            )

            // -------------------------------------------------
            // 2. PERSISTENCE COMPUTATION (Closure)
            // -------------------------------------------------

            let persistence = max(
                0.0,
                1.0 - (delta * state.calibration.stabilityScale)
            )

            // -------------------------------------------------
            // 3. MANIFOLD EVOLUTION (Crystallization)
            // -------------------------------------------------

            let newPhaseValue =
                (state.manifoldPhase.doubleValue * (1.0 - persistence)) +
                (telemetry.doubleValue * persistence)

            state.manifoldPhase = FixedPoint(newPhaseValue)

            // -------------------------------------------------
            // 4. RECURSIVE CALIBRATION (Self-Anchoring)
            // -------------------------------------------------

            state.calibration = state.calibration.updated(
                observedVariance: delta,
                rate: settings.learningRate
            )

            state.accumulatedAction += delta * persistence

            // -------------------------------------------------
            // 5. TRUTH GENERATION (Domain-Separated Binding)
            // -------------------------------------------------

            var hasher = SHA256()

            hasher.update(
                data: "DVSM-V21-REIFIED".data(using: .utf8)!
            )

            hasher.update(data: input)

            hasher.update(
                data: withUnsafeBytes(
                    of: state.manifoldPhase.rawValue.bigEndian
                ) { Data($0) }
            )

            let truth = Data(hasher.finalize())

            // -------------------------------------------------
            // 6. RECORD TRAJECTORY
            // -------------------------------------------------

            state.trajectory.append(
                DVSMTrajectorySample(
                    persistence: persistence,
                    phaseDelta: delta,
                    timestamp: UInt64(Date().timeIntervalSince1970)
                )
            )

            // Maintain bounded trajectory memory.
            if state.trajectory.count > settings.trajectoryWindow {
                state.trajectory.removeFirst(
                    state.trajectory.count - settings.trajectoryWindow
                )
            }

            // -------------------------------------------------
            // 7. LIFECYCLE TRANSITION
            // -------------------------------------------------

            state.lifecycle =
                (delta > settings.divergenceThreshold)
                ? .divergent
                : .reified

            return (
                truth: truth,
                persistence: persistence
            )
        }
    }
}

// =====================================================
// MARK: - 7. INTEGRATION HELPERS & SDK HOOKS
