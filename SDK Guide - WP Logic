public struct FixedPoint: Sendable, Hashable, Comparable {

    public let rawValue: Int64

    public static let scale: Int64 = 1_000_000

    public init(_ value: Double) {
        self.rawValue = Int64(value * Double(Self.scale))
    }

    public init(raw: Int64) {
        self.rawValue = raw
    }

    public var doubleValue: Double {
        Double(rawValue) / Double(Self.scale)
    }

    public static func + (lhs: FixedPoint, rhs: FixedPoint) -> FixedPoint {
        .init(raw: lhs.rawValue + rhs.rawValue)
    }

    public static func - (lhs: FixedPoint, rhs: FixedPoint) -> FixedPoint {
        .init(raw: lhs.rawValue - rhs.rawValue)
    }

    public static func < (lhs: FixedPoint, rhs: FixedPoint) -> Bool {
        lhs.rawValue < rhs.rawValue
    }
}

