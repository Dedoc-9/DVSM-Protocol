public extension DVSMKernel {

    struct ManifoldStatus: Sendable {

        public let phase: Double
        public let stability: Double
        public let coupling: Double
        public let totalAction: Double
        public let lifecycle: DVSMLifecycle
        public let trajectoryDepth: Int
    }

    /// Snapshot diagnostic hook.
    func queryStatus() -> ManifoldStatus {

        state.withLock { state in

            ManifoldStatus(
                phase: state.manifoldPhase.doubleValue,
                stability: state.calibration.stabilityScale,
                coupling: state.calibration.couplingCoefficient,
                totalAction: state.accumulatedAction,
                lifecycle: state.lifecycle,
                trajectoryDepth: state.trajectory.count
            )
        }
    }

    /// Read-only trajectory export.
    func exportTrajectory() -> [DVSMTrajectorySample] {

        state.withLock { $0.trajectory }
    }

    /// Controlled terminal shutdown.
    func terminate() {

        state.withLock { state in
            state.lifecycle = .terminal
        }
    }
}

