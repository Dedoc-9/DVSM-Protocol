public struct DVSMCalibrationFrame: Sendable {

    /// Internal damping coefficient.
    public var stabilityScale: Double

    /// Baseline entropy normalization.
    public var baselineEntropy: Double

    /// Recursive coupling coefficient.
    public var couplingCoefficient: Double

    public static let identity = DVSMCalibrationFrame(
        stabilityScale: 1.0,
        baselineEntropy: 0.0,
        couplingCoefficient: 1.0
    )

    /// Recursive self-stabilization update rule.
    public func updated(
        observedVariance: Double,
        rate: Double
    ) -> DVSMCalibrationFrame {

        var next = self

        // Stability adapts toward equilibrium.
        next.stabilityScale *= (
            1.0 + rate * (0.5 - observedVariance)
        )

        // Entropy baseline slowly recenters.
        next.baselineEntropy += (
            observedVariance * rate * 0.01
        )

        // Coupling weakens under persistent variance.
        next.couplingCoefficient *= (
            1.0 - min(0.25, observedVariance * rate * 0.1)
        )

        return next
    }
}

