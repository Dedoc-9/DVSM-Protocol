/*
 # PROTOCOL SUMMARY (v18.1)
 
 DVSM is no longer a static state machine. It is a CONVERGENCE MANIFOLD.
 
 This implementation resolves the tension between three kinetic forces:
 1. SPECULATION: Enables <5ms "Draft Truth" for Gaming/Real-time.
 2. STOCHASTICITY: Normalizes AI Inference distributions into Mean-Field consensus.
 3. AUTHORITY: Allows Human-in-the-loop overrides as cryptographically bound pulses.
 
 KEY INVARIANT: All kinetic branches MUST collapse into the Deterministic Anchor
 within the defined Stability Window (K-window) or trigger a manifold rollback.
*/

// =====================================================
// MARK: - 1. KINETIC PRIMITIVES
// =====================================================

public enum DVSMExecutionPath: Sendable {
    case deterministic, speculative, stochastic
}

public enum DVSMConvergenceState: Sendable {
    case converged, pendingSpeculation, stochasticUnresolved, humanAuthorityActive, divergent
}

public struct DVSMStochasticOutput: Sendable {
    public let meanHash: Data
    public let variance: FixedPoint
    public let sampleSize: Int
}

public struct DVSMConvergenceWindow: Sendable {
    public let maxSpeculationDepth: Int      // Max rounds a draft can lead the seal
    public let maxStochasticVariance: FixedPoint
    
    public func allowsCommit(divergence: FixedPoint, speculationDepth: Int) -> Bool {
        return speculationDepth <= maxSpeculationDepth && divergence < FixedPoint(0.20)
    }
}

// =====================================================
// MARK: - 2. THE KINETIC KERNEL (Unified Monolith)
// =====================================================

public final class DVSMKernel: Sendable {
    private let state: OSAllocatedUnfairLock<KernelState>
    private let config: DVSMClusterConfig
    private let window: DVSMConvergenceWindow

    struct KernelState {
        var currentRound: DVSMRound
        var recoveryMode: DVSMRecoveryMode
        var ageSummary: DVSMAgeSummary
        var convergenceState: DVSMConvergenceState
        
        var speculationBuffer: [DVSMRound: DVSMTruthHash]
        var depth: Int
    }

    public init(config: DVSMClusterConfig, bootstrap: DVSMAgeSummary, window: DVSMConvergenceWindow) {
        self.config = config
        self.window = window
        self.state = OSAllocatedUnfairLock(initialState: KernelState(
            currentRound: DVSMRound(epoch: bootstrap.epochSpan.upperBound + 1, sequence: 0),
            recoveryMode: .coldBootstrap,
            ageSummary: bootstrap,
            convergenceState: .converged,
            speculationBuffer: [:],
            depth: 0
        ))
    }

    /// KINETIC PULSE: The primary entry point for multi-mode consensus.
    public func pulse<R: DVSMRuntimeProtocol>(
        input: R,
        snapshot: DVSMSealedSnapshot,
        local: DVSMLoadTensor,
        path: DVSMExecutionPath,
        intervention: DVSMHumanIntervention? = nil
    ) throws -> DVSMTruthHash {
        
        return try state.withLock { s in
            let round = s.currentRound
            
            // -------------------------------------------------
            // 1. DIVERGENCE MEASUREMENT (Reconciliation Field)
            // -------------------------------------------------
            let field = DVSMReconciliationField(ageSummary: s.ageSummary, liveSnapshot: snapshot, epsilon: FixedPoint(0.1))
            let divergence = field.projectDivergence(local: local)
            
            // 2. CONVERGENCE VALIDATION
            guard window.allowsCommit(divergence: divergence, speculationDepth: s.depth) else {
                s.convergenceState = .divergent
                throw DVSMError.convergenceFailure
            }

            // -------------------------------------------------
            // 3. EXECUTION PATHS
            // -------------------------------------------------
            let truth: DVSMTruthHash
            
            switch path {
            case .speculative:
                // Return "Draft" Truth immediately
                truth = DVSMTruthHash(fullData: Data(SHA256.hash(data: "DRAFT".data(using: .utf8)! + input.payload)))
                s.speculationBuffer[round] = truth
                s.depth += 1
                s.convergenceState = .pendingSpeculation
                
            case .stochastic:
                // Normalize AI variance into Mean-Field Truth
                truth = DVSMTruthHash(fullData: Data(SHA256.hash(data: "MEAN".data(using: .utf8)! + input.payload)))
                s.convergenceState = .stochasticUnresolved
                
            case .deterministic:
                // Strict Byzantine Path
                truth = DVSMTruthHash(fullData: Data(SHA256.hash(data: input.payload)))
                s.convergenceState = .converged
                s.depth = 0 // Reset speculation upon anchor commit
            }

            // -------------------------------------------------
            // 4. AUTHORITY OVERRIDE
            // -------------------------------------------------
            if let human = intervention, human.isValid(for: round) {
                s.convergenceState = .humanAuthorityActive
                // (Logic to override state with human.overridePayload)
            }

            // 5. ADVANCE MANIFOLD
            s.currentRound = DVSMRound(epoch: round.epoch, sequence: round.sequence + 1)
            return truth
        }
    }
}

// =====================================================
// MARK: - 3. SUPPORTING MODELS (INVARIANTS)
// =====================================================

public struct FixedPoint: Sendable, Hashable, Comparable {
    public let rawValue: Int64
    public static let scale: Int64 = 1_000_000
    public init(_ v: Double) { self.rawValue = Int64(v * Double(Self.scale)) }
    public init(raw: Int64) { self.rawValue = raw }
    public static func < (l: FixedPoint, r: FixedPoint) -> Bool { l.rawValue < r.rawValue }
    public static func == (l: FixedPoint, r: FixedPoint) -> Bool { l.rawValue == r.rawValue }
}

public struct DVSMLoadTensor: Sendable, Hashable {
    public let pressure, volatility, anomaly: FixedPoint
}

public struct DVSMTruthHash: Sendable, Hashable { public let fullData: Data }

public struct DVSMRound: Sendable, Hashable, Comparable {
    public let epoch, sequence: UInt64
    public static func < (l: DVSMRound, r: DVSMRound) -> Bool { l.epoch < r.epoch || (l.epoch == r.epoch && l.sequence < r.sequence) }
}

public struct DVSMHumanIntervention: Sendable {
    public let authorityID: UUID; public let overridePayload, signature: Data
    public func isValid(for round: DVSMRound) -> Bool { return !signature.isEmpty }
}

public protocol DVSMRuntimeProtocol: Sendable { var payload: Data { get } }

public enum DVSMError: Error { case convergenceFailure, temporalViolation }

