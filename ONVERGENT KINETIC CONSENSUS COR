public extension DVSMKernel {

    /// Derived diagnostic snapshot for external systems (monitoring / world-scale observability)
    struct DVSMKernelTelemetry: Sendable {
        public let round: DVSMRound
        public let convergence: DVSMConvergenceState
        public let recovery: DVSMRecoveryMode
        public let speculationDepth: Int
        public let ageEpoch: ClosedRange<UInt64>
    }

    /// Emits a deterministic, side-effect-free snapshot of kernel health.
    func telemetry() -> DVSMKernelTelemetry {
        state.withLock { s in
            DVSMKernelTelemetry(
                round: s.currentRound,
                convergence: s.convergenceState,
                recovery: s.recoveryMode,
                speculationDepth: s.depth,
                ageEpoch: s.ageSummary.epochSpan
            )
        }
    }
}

// =====================================================
// MARK: - 2. CONVERGENCE HARDENING RULES (ADD-ON INVARIANTS)
// =====================================================

/*
 INVARIANT K — SPECULATION BOUNDARY STABILITY
 - Speculation depth MUST NOT grow without convergence decay pressure.
 - If depth > 0 for > N rounds without deterministic anchor,
   system SHOULD force rollback to last converged state.
*/

public extension DVSMConvergenceWindow {

    /// Optional safety check for runaway speculative drift.
    func requiresRollback(depth: Int, divergence: FixedPoint) -> Bool {
        return depth > maxSpeculationDepth && divergence > maxStochasticVariance
    }
}

