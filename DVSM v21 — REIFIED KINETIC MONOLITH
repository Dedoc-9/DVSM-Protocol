// MARK: - 3. THE REIFIED KERNEL (PULSE DYNAMICS)
// =====================================================

public final class DVSMKernel: Sendable {
    private let state: OSAllocatedUnfairLock<KernelState>
    
    struct KernelState {
        var currentRound: UInt64
        var activeFrame: DVSMCalibrationFrame
        var manifoldPhase: FixedPoint // Integrated history as Curvature
        var speculationDepth: Int
    }

    public init(bootstrap: DVSMLoadTensor) {
        self.state = OSAllocatedUnfairLock(initialState: KernelState(
            currentRound: 0,
            activeFrame: .identity,
            manifoldPhase: bootstrap.pressure,
            speculationDepth: 0
        ))
    }

    /// PIONEERING PULSE (SPECULATIVE-RECURSIVE)
    /// This implementation allows for "Infinite Throughput" by treating 
    /// consensus as a continuous field-alignment process.
    public func pulse(input: Data, telemetry: DVSMLoadTensor) throws -> (Data, Double) {
        return try state.withLock { s in
            
            // 1. PROJECT DIVERGENCE
            // Calculate distance between local signal and manifold phase.
            let delta = abs(telemetry.pressure.doubleValue - s.manifoldPhase.doubleValue)
            
            // 2. CALIBRATED PERSISTENCE (The Filter)
            // Use the recursive frame to decide how much this pulse "matters."
            let persistence = max(0, 1.0 - (delta * s.activeFrame.stabilityScale))
            
            // 3. PHASE EVOLUTION (The Emergent Truth)
            // Instead of a binary "Yes/No", the manifold phase absorbs a fraction 
            // of the data proportional to its persistence.
            let newPhase = (s.manifoldPhase.doubleValue * (1.0 - persistence)) + (telemetry.pressure.doubleValue * persistence)
            s.manifoldPhase = FixedPoint(newPhase)
            
            // 4. RECURSIVE SELF-ADJUSTMENT
            // The system observes its own error and recalibrates for the next round.
            s.activeFrame = s.activeFrame.adjust(observedVariance: delta)
            
            // 5. TRUTH GENERATION (Crystallization)
            // The "Truth" is the current Manifold Phase hashed with the Input.
            let eigenData = input + withUnsafeBytes(of: s.manifoldPhase.rawValue.bigEndian) { Data($0) }
            let truthHash = Data(SHA256.hash(data: eigenData))
            
            s.currentRound += 1
            
            return (truthHash, persistence)
        }
    }
}

