import Foundation
import Accelerate

/// Clean spectral regularized gradient flow on Sym(16)
public final class DVSMKernel: @unchecked Sendable {
    private let lock = NSLock()
    private var D: [Double]

    private let stepSize: Double = 0.02
    private let t: Double = 0.05
    private let N = 16

    public init() {
        self.D = (0..<256).map { $0 % 17 == 0 ? 1.0 : 0.0 }
    }

    /// Gradient flow on symmetric matrices with external forcing
    public func pulse(flux: SIMD16<Double>) -> [Double] {
        lock.lock(); defer { lock.unlock() }

        // -------------------------------------------------
        // 1. Intrinsic gradient (from truncated spectral action)
        // S(D) ≈ Tr(I - t D²)
        // ∇S = -2t D
        // -------------------------------------------------
        var grad = D.map { -2.0 * t * $0 }

        // -------------------------------------------------
        // 2. External forcing (low-rank interaction)
        // flux ⊗ flux
        // -------------------------------------------------
        for i in 0..<N {
            for j in 0..<N {
                let idx = i * N + j
                grad[idx] += flux[i] * flux[j] * 0.05
            }
        }

        // -------------------------------------------------
        // 3. Gradient descent step
        // -------------------------------------------------
        for i in 0..<256 {
            D[i] -= stepSize * grad[i]
        }

        // -------------------------------------------------
        // 4. Projection onto Sym(16)
        // -------------------------------------------------
        for i in 0..<N {
            for j in i+1..<N {
                let avg = 0.5 * (D[i*N + j] + D[j*N + i])
                D[i*N + j] = avg
                D[j*N + i] = avg
            }
        }

        return D
    }
}

